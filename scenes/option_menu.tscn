[sub_resource type="GDScript" id="GDScript_40sux"]
script/source = "extends Control

@onready var anim = $KLANG

# Pour savoir quelle action attend un rebinding
var waiting_for_input: String = \"\"

func _on_volume_slider_value_changed(value: float) -> void:
	Music.volume_db = value


func _on_back_butt_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/main_menu.tscn\")


func _ready():
	$ButtonChange.connect(\"pressed\", Callable(self, \"_on_change_pressed\"))
	anim.play(\"KLANG\")  # Nom de ton animation


func _on_button_change_pressed() -> void:
	waiting_for_input = \"flap\"  # Nom de l’action à rebinder
	$LabelDisplay.text = \"Appuyez sur une touche\"
	$ButtonChange.release_focus()
	print(\"Appuyez sur une touche pour flap\")

func _unhandled_input(event):
	if waiting_for_input != \"\":
		if event is InputEventKey and event.pressed:
			var new_event = InputEventKey.new()
			new_event.keycode = event.keycode

			# Supprime les anciennes touches
			InputMap.action_erase_events(waiting_for_input)
			# Ajoute la nouvelle touche
			InputMap.action_add_event(waiting_for_input, new_event)
			#Traduit l'input choisi en texte compréhensible pour un humain 
			var key_name = OS.get_keycode_string(new_event.keycode)
			$LabelDisplay.text = str(key_name)
			print(\"Nouvelle touche pour\", waiting_for_input, \":\", str(key_name))
			
			waiting_for_input = \"\"
"

